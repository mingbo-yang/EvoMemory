# Source this file in your shell after replacing the checkpoint path.
export EVOMEMORY_MODEL_PATH=/absolute/path/to/Qwen3.8-27B
export EVOMEMORY_MODEL_NAME=qwen3.8-27b-local
export EVOMEMORY_BASE_URL=http://127.0.0.1:8140/v1
export EVOMEMORY_MODEL_MANIFEST="$PWD/configs/local_model.json"
# Optional embedding and multimodal models require separately installed assets.
# 0 exposes the configured local generation endpoint without those CPU models.
export EVOMEMORY_ENABLE_OPTIONAL_MODELS=0
export TMPDIR=/tmp
export PYTHONHASHSEED=0
